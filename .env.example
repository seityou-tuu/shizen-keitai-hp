# 公開情報・法定表示と本番公開の確認が済んだ後、VercelのProductionだけtrueにします。
# Previewではtrueでも検索登録を許可しません。既定はfalseです。
SITE_INDEXING_ENABLED=false

# GA4は未接続。正式ID・Production・有効化・訪問者の許可が揃うまで送信しません。
# 有効化前にプライバシー文面とGA4の拡張計測OFFを確認してください。
GA4_ENABLED=false
GA4_MEASUREMENT_ID=

# Search Consoleが発行したHTMLタグのcontent値のみ。未設定ならタグを出しません。
GOOGLE_SITE_VERIFICATION=
